{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "memory-migrator.profile.v1",
  "title": "Portable memory profile v1",
  "description": "Mirrors validatePortable() in supabase/functions/_shared/mm/portable.ts. Runtime validation additionally checks quote hashes, code-point spans, alias identity, duplicate identities and canonicalPayloadSha256 (SHA-256 of the canonical v1 bytes of the object without that field). The checksum is not proof of authenticity. Self-described approval or verification never grants authority on import.",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "schemaVersion", "codecVersion", "originProfileId", "parserVersions", "extractorVersions", "includeSensitive", "facts", "tombstones", "versions", "canonicalPayloadSha256"],
  "properties": {
    "format": { "const": "memory-migrator.profile" },
    "schemaVersion": { "const": 1 },
    "codecVersion": { "const": 1 },
    "originProfileId": { "$ref": "#/$defs/id" },
    "parserVersions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
    "extractorVersions": { "type": "array", "maxItems": 20, "items": { "type": "string", "maxLength": 64 } },
    "includeSensitive": { "type": "boolean" },
    "facts": { "type": "array", "maxItems": 500, "items": { "$ref": "#/$defs/fact" } },
    "tombstones": { "type": "array", "maxItems": 10000, "items": { "$ref": "#/$defs/tombstone" } },
    "versions": { "type": "array", "maxItems": 1000, "items": { "$ref": "#/$defs/version" } },
    "canonicalPayloadSha256": { "$ref": "#/$defs/hex64" }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "hex64": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "time": { "type": "string", "pattern": "^\[0-9]{4}-\[0-9]{2}-\[0-9]{2}T\[0-9]{2}:\[0-9]{2}:\[0-9]{2}Z$" },
    "timeOrNull": { "oneOf": [{ "$ref": "#/$defs/time" }, { "type": "null" }] },
    "slot": { "enum": ["identity.name", "location.home", "work.role", "work.employer", "preference.likes", "preference.dislikes", "health.note", "financial.note"] },
    "sensitivity": { "enum": ["health", "finance", "intimate", "belief", "minors", "precise_location"] },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "revision", "slot", "polarity", "value", "assertion", "userAuthored", "sensitivity", "firstSeen", "lastSeen", "aliasKeys", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "revision": { "type": "integer", "minimum": 1 },
        "slot": { "$ref": "#/$defs/slot" },
        "polarity": { "enum": ["assert", "deny"] },
        "value": { "type": "string", "minLength": 1, "description": "At most 280 Unicode code points." },
        "assertion": { "type": "string", "minLength": 1 },
        "userAuthored": { "type": "boolean" },
        "sensitivity": { "type": "array", "items": { "$ref": "#/$defs/sensitivity" } },
        "scopeNote": { "type": "string" },
        "firstSeen": { "$ref": "#/$defs/timeOrNull" },
        "lastSeen": { "$ref": "#/$defs/timeOrNull" },
        "aliasKeys": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/hex64" } },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/evidence" } }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sourceDigest", "conversationId", "messageId", "role", "textSha256", "start", "end", "quote", "quoteSha256", "parserVersion", "sourceTime"],
      "properties": {
        "sourceDigest": { "$ref": "#/$defs/hex64" },
        "conversationId": { "type": "string", "maxLength": 256 },
        "messageId": { "type": "string", "maxLength": 256 },
        "role": { "const": "user" },
        "textSha256": { "$ref": "#/$defs/hex64" },
        "start": { "type": "integer", "minimum": 0, "description": "Unicode code point offset, inclusive." },
        "end": { "type": "integer", "minimum": 1, "description": "Unicode code point offset, exclusive." },
        "quote": { "type": "string", "minLength": 1, "description": "At most 280 code points; end - start equals its code-point length." },
        "quoteSha256": { "$ref": "#/$defs/hex64" },
        "parserVersion": { "const": "chatgpt-json/1" },
        "sourceTime": { "$ref": "#/$defs/timeOrNull" }
      }
    },
    "tombstone": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "generationId", "keys", "mode", "at"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "generationId": { "$ref": "#/$defs/id" },
        "keys": { "type": "array", "minItems": 1, "maxItems": 50, "items": { "$ref": "#/$defs/hex64" } },
        "mode": { "enum": ["erase", "hide"] },
        "at": { "$ref": "#/$defs/time" }
      }
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "label", "digest", "createdAt"],
      "properties": {
        "seq": { "type": "integer", "minimum": 1 },
        "label": { "type": "string", "maxLength": 80 },
        "digest": { "$ref": "#/$defs/hex64" },
        "createdAt": { "$ref": "#/$defs/time" }
      }
    }
  }
}
