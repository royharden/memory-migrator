# Public browser configuration for optional account mode. These identify the project;
# they are not a service-role key. Local mode works without them.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# No server or provider secrets are needed for the MVP.
# MEMORY_EXTRACT_API_KEY / MEMORY_EXTRACT_URL are historical names used only by the retained,
# disconnected supabase/functions/propose-facts source. Do not obtain or set them for the MVP,
# and never give any secret a VITE_ prefix.
